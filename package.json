{
  "name": "container-loader",
  "version": "1.3.1",
  "description": "3D 装柜计算软件：多箱型混装、自动装载优化、PDF/Excel/HTML/PNG 报告导出",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node test/packer.test.js && node test/csv.test.js"
  },
  "author": "hawchou1995",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "http-proxy-agent": "^7.0.2",
    "proxy-agent": "^6.4.0",
    "three": "^0.170.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.hawchou.container-loader",
    "productName": "装柜大师",
    "artifactName": "container-loader-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "装柜大师"
    }
  }
}
